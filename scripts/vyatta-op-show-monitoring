#!/bin/bash
# Implementation of the "show monitoring" operational command

bindir=${vyatta_bindir:-/opt/vyatta/bin}

echo "------------------------------"
echo "  Dataplane monitoring status"
echo "------------------------------"
"$bindir"/opc show monitoring dataplane

echo "------------------------------"
echo "  Protocol monitoring status"
echo "------------------------------"
"$bindir"/opc show monitoring protocols
